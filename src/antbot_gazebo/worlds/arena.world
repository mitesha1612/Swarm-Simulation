<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="antbot_arena">
    <plugin name="gazebo_ros_factory" filename="libgazebo_ros_factory.so"/>

    <!-- ── Lighting ──────────────────────────────────────────────────────── -->
    <light type="directional" name="sun">
      <cast_shadows>true</cast_shadows>
      <pose>0 0 10 0 0 0</pose>
      <diffuse>0.85 0.85 0.85 1</diffuse>
      <specular>0.2 0.2 0.2 1</specular>
      <attenuation>
        <range>1000</range><constant>0.9</constant>
        <linear>0.01</linear><quadratic>0.001</quadratic>
      </attenuation>
      <direction>-0.5 0.1 -0.9</direction>
    </light>

    <!-- ── Ground plane ──────────────────────────────────────────────────── -->
    <model name="ground_plane">
      <static>true</static>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <surface><friction><ode><mu>100</mu><mu2>50</mu2></ode></friction></surface>
        </collision>
        <visual name="visual">
          <geometry>
            <plane><normal>0 0 1</normal><size>100 100</size></plane>
          </geometry>
          <material>
            <ambient>0.55 0.55 0.55 1</ambient>
            <diffuse>0.55 0.55 0.55 1</diffuse>
          </material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════════
         ARENA BOUNDARY  –  2 m × 2 m interior
         Walls sit at ±1.05 m  (wall thickness = 0.1 m, height = 0.25 m)
         Interior usable: −1.0 m → +1.0 m on both axes
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- North wall (+Y) -->
    <model name="wall_north">
      <static>true</static>
      <pose>0 1.05 0.125 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.2 0.1 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.2 0.1 0.25</size></box></geometry>
          <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- South wall (-Y) -->
    <model name="wall_south">
      <static>true</static>
      <pose>0 -1.05 0.125 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>2.2 0.1 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>2.2 0.1 0.25</size></box></geometry>
          <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- East wall (+X) -->
    <model name="wall_east">
      <static>true</static>
      <pose>1.05 0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.2 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.2 0.25</size></box></geometry>
          <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- West wall (-X) -->
    <model name="wall_west">
      <static>true</static>
      <pose>-1.05 0 0.125 0 0 0</pose>
      <link name="link">
        <collision name="col"><geometry><box><size>0.1 2.2 0.25</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.1 2.2 0.25</size></box></geometry>
          <material><ambient>0.2 0.4 0.9 1</ambient><diffuse>0.2 0.4 0.9 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ══════════════════════════════════════════════════════════════════════
         CUBES  –  scaled to 0.12 m to fit nicely in 2×2 arena
         ══════════════════════════════════════════════════════════════════════ -->

    <!-- Red cube (distractor) -->
    <model name="red_cube">
      <pose>-0.6 0.6 0.09 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.18 0.18 0.18</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.18 0.18 0.18</size></box></geometry>
          <material><ambient>1 0.1 0.1 1</ambient><diffuse>1 0.1 0.1 1</diffuse></material>
        </visual>
      </link>
    </model>

    <!-- ── THE ONE GREEN CUBE  (target) ──────────────────────────────────── -->
    <model name="goal">
      <pose>0.7 0.7 0.09 0 0 0</pose>
      <static>true</static>
      <link name="link">
        <collision name="col"><geometry><box><size>0.18 0.18 0.18</size></box></geometry></collision>
        <visual name="vis">
          <geometry><box><size>0.18 0.18 0.18</size></box></geometry>
          <material><ambient>0.0 1.0 0.0 1</ambient><diffuse>0.0 1.0 0.0 1</diffuse></material>
        </visual>
      </link>
    </model>

  </world>
</sdf>
